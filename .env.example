# Google Gemini API Key (Required for live Gemini API calls)
# Get a free key at https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here

# LLM Configuration
OMNIRAG_MODEL=gemini-2.0-flash
OMNIRAG_TEMPERATURE=0.2
OMNIRAG_MAX_OUTPUT_TOKENS=2048

# Operational Mode
# Set to 'false' if GEMINI_API_KEY is not provided (falls back to deterministic mock engine)
OMNIRAG_USE_MOCK=false

# Retrieval Configuration
OMNIRAG_CHUNK_SIZE=350
OMNIRAG_CHUNK_OVERLAP=60
OMNIRAG_TOP_K_RETRIEVAL=5
OMNIRAG_RRF_K=60

# Web Dashboard Port
OMNIRAG_WEB_PORT=8000
